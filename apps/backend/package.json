{
    "name": "@dtc/backend",
    "version": "0.0.1",
    "description": "A starter for Medusa projects.",
    "author": "Medusa (https://medusajs.com)",
    "license": "MIT",
    "keywords": [
        "sqlite",
        "postgres",
        "typescript",
        "ecommerce",
        "headless",
        "medusa"
    ],
    "scripts": {
        "build": "medusa build",
        "start": "medusa db:migrate && medusa start",
        "dev": "medusa develop",
        "lint": "medusa lint",
        "test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
        "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
        "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit",
        "postinstall": "patch-package"
    },
    "dependencies": {
        "@agilo/medusa-analytics-plugin": "^1.4.0",
        "@medusajs/admin-sdk": "2.21.2",
        "@medusajs/admin-shared": "2.21.2",
        "@medusajs/caching": "2.21.2",
        "@medusajs/cli": "2.21.2",
        "@medusajs/dashboard": "2.21.2",
        "@medusajs/draft-order": "2.21.2",
        "@medusajs/framework": "2.21.2",
        "@medusajs/icons": "2.21.2",
        "@medusajs/medusa": "2.21.2",
        "@medusajs/ui": "4.2.6",
        "@radix-ui/react-popover": "^1.1.14",
        "@radix-ui/react-slot": "^1.2.3",
        "@tanstack/react-query": "5.64.2",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "date-fns": "^4.1.0",
        "lucide-react": "^0.563.0",
        "luxon": "^3.6.1",
        "react-aria-components": "^1.10.1",
        "react-day-picker": "^9.13.2",
        "react-i18next": "13.5.0",
        "react-router-dom": "7.18.2",
        "recharts": "^2.15.1",
        "tailwind-merge": "^3.4.0",
        "tw-animate-css": "^1.3.4",
        "zod": "4.2.0"
    },
    "devDependencies": {
        "@medusajs/test-utils": "2.21.2",
        "@swc/core": "^1.7.28",
        "@swc/jest": "^0.2.36",
        "@types/jest": "^29.5.13",
        "@types/node": "^20.12.11",
        "@types/react": "^18.3.2",
        "@types/react-dom": "^18.2.25",
        "jest": "^29.7.0",
        "patch-package": "^8.0.1",
        "prop-types": "^15.8.1",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "tailwindcss": "^3.4.17",
        "ts-node": "^10.9.2",
        "typescript": "^5.6.2",
        "vite": "^7.3.6",
        "yalc": "^1.0.0-pre.53"
    },
    "overrides": {
        "tailwindcss": "^3.4.17",
        "@agilo/medusa-analytics-plugin": {
            "recharts": "$recharts"
        }
    },
    "engines": {
        "node": ">=20.0.0"
    }
}
